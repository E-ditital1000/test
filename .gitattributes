# The team works on Windows; normalise line endings in the repository so a
# checkout on another machine does not show every file as modified.
* text=auto

# Binary assets git should never try to normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Server-side files must be LF regardless of who edits them. A shell script
# checked out with CRLF fails on Linux with "bad interpreter: ^M", and
# systemd and nginx are no happier about it.
*.sh          text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
deploy/*.example text eol=lf
