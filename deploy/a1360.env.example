# A1 360 — production environment
#
# Copy to /srv/a1360/.env, fill in, then:  chmod 600 /srv/a1360/.env
# It holds the database password and the signing key; it is read by the
# systemd unit and must never be committed.

# --- required -------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

DEBUG=False

# Every hostname the site answers on. No scheme, no trailing slash.
ALLOWED_HOSTS=a1360.example.com

# Django checks the Origin header behind a proxy; this needs the scheme.
CSRF_TRUSTED_ORIGINS=https://a1360.example.com

# Postgres. SQLite will not survive more than one worker.
DATABASE_URL=postgres://a1360:CHANGE_ME@127.0.0.1:5432/a1360


# --- media ----------------------------------------------------------------
# Assessment photographs and expense receipts. Leave CLOUDINARY_CLOUD_NAME
# blank to keep them on the server's own disk at MEDIA_ROOT, which is fine
# for a single box provided that disk is in your backups.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# --- optional -------------------------------------------------------------

# OFF by default, and deliberately. HSTS tells every browser to refuse plain
# HTTP for this domain for the whole period, and a browser that has cached
# that instruction cannot be told otherwise. Set it to 31536000 (one year)
# only AFTER https:// is confirmed working on the real domain.
SECURE_HSTS_SECONDS=0

# The credential list on the sign-in page. Defaults to DEBUG, so it is
# already off here — set it only if you deliberately want a demo box.
# SHOW_DEMO_ACCOUNTS=False

# One assessment can carry twelve photographs as base64. Keep this and
# nginx's client_max_body_size in step.
# DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
