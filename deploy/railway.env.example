# A1 360 on Railway — the variables the deployed app reads.
#
# These are NOT read from a file. Set them on the app service in the Railway
# dashboard, under Variables. This file is the checklist, committed so the
# list cannot go missing; it holds no secrets and never should.
#
# The .env in the project root is a different thing entirely: that one is
# read on a developer's own machine and is never deployed.
#
# Full walkthrough: docs/deploy-railway.md


# --- required -------------------------------------------------------------

# Generate a fresh one for production. Not the one on anybody's laptop.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# MUST be set before the first successful build. With it unset the build
# defaults to DEBUG on, collectstatic writes no static manifest, and the app
# then raises "Missing staticfiles manifest entry" on every page.
DEBUG=False

# The Railway domain, no scheme and no trailing slash. Add a custom domain
# here too once it points at the service, comma separated.
ALLOWED_HOSTS=a1360-production.up.railway.app

# The same host WITH the scheme. Django checks the Origin header behind a
# proxy, and a POST is rejected without this.
CSRF_TRUSTED_ORIGINS=https://a1360-production.up.railway.app

# Reference the database service rather than pasting a password. Railway
# substitutes the private URL, which is what the app should use — it does not
# leave their network and is not rate limited like the public proxy.
DATABASE_URL=${{Postgres.DATABASE_URL}}


# --- media ----------------------------------------------------------------
# Assessment photographs and expense receipts.
#
# Railway gives Cloudinary as one CLOUDINARY_URL of the form
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# This project reads the three parts separately, so split it: the cloud name
# is the part after the @, the key and secret either side of the colon.
#
# Leave them blank and uploads go to the container's own disk, which Railway
# wipes on every deploy. A week of site photographs would disappear with the
# next release.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# --- optional -------------------------------------------------------------

# OFF until https:// is confirmed working on the real domain, and
# deliberately. HSTS tells every browser to refuse plain HTTP for this domain
# for the whole period, and a browser that has cached that instruction cannot
# be told otherwise. Set to 31536000 (one year) once you are sure.
SECURE_HSTS_SECONDS=0

# Gunicorn workers. Three suits Railway's smaller instances; raise it with
# the plan, not past it.
# WEB_CONCURRENCY=3

# One assessment can carry twelve photographs as base64.
# DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
